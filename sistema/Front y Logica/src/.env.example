# ===========================================
# VARIABLES DE ENTORNO — Specialized Instrumental Dental
# ===========================================
# Copia este archivo como .env en la carpeta /src/ y completa con tus valores reales.
# NUNCA subas .env a Git (contiene credenciales sensibles).
# ===========================================

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_example
DB_USER=gr_example
DB_PASSWORD=tu_contraseña_aqui

# --- JWT (autenticación) ---
# Clave secreta para firmar tokens. Mínimo 32 caracteres aleatorios.
# Generar con: openssl rand -base64 32
JWT_SECRET=cambiar_por_clave_segura_minimo_32_caracteres

# --- Entorno ---
# desarrollo | produccion
APP_ENV=desarrollo

# --- Depuración (Debug) ---
# true para ver detalles técnicos de errores en respuestas JSON | false para ocultarlos en producción
APP_DEBUG=true

# --- SMTP (Recuperación de contraseña por email) ---
# Para Gmail: usar smtp.gmail.com con una "Contraseña de aplicación" de 16 caracteres
# (Google Account -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_aqui
SMTP_FROM_NAME=SPECIALIZED
