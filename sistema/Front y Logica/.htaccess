# ==============================================================================
# SEGURIDAD Y CONTROL DE ACCESO - SPECIALIZED INSTRUMENTAL DENTAL
# ==============================================================================

# 1. Deshabilitar listado de directorios
Options -Indexes

# 2. Bloquear archivos sensibles y de configuración
<FilesMatch "^\.|\.(env|env\..*|json|lock|log|sql|md|sh|git.*|yml|yaml|ini|bak|conf|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Proteger .htaccess explícitamente
<Files ".htaccess">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# 4. Reglas de reescritura seguras (solo si mod_rewrite está disponible)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(env|env\..*|json|lock|log|sql|md|sh|git.*|yml|yaml|ini|bak|conf|htaccess)$ - [F,L]
    RewriteRule ^(docs|sql)/ - [F,L]
</IfModule>
