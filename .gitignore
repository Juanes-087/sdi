# ===========================================
# Variables de entorno y credenciales (CRÍTICO)
# ===========================================
**/.env
**/*.env
**/.env.local
!**/.env.example
!**/.env.docker.example

# ===========================================
# Dependencias (Node / Composer)
# ===========================================
**/node_modules/
**/vendor/

# ===========================================
# Archivos subidos por usuarios y multimedia dinámica
# ===========================================
**/images/instrum/*
**/images/kit/*
**/images/prod/*
**/images/mat_prima/*
!**/images/instrum/.gitkeep
!**/images/kit/.gitkeep
!**/images/prod/.gitkeep
!**/images/mat_prima/.gitkeep

# ===========================================
# Archivos multimedia pesados
# ===========================================
**/*.mkv
**/*.mp4
**/*.mov

# ===========================================
# Logs, temporales y volcados del sistema
# ===========================================
*.log
**/*.log
*.txt
scratch/
.system_generated/
error_log
php_error.log
desktop.ini
Thumbs.db
.DS_Store

# ===========================================
# IDEs, Editores y Entornos
# ===========================================
.vscode/
.idea/
.gemini/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
