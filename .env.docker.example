# ==============================================================================
# VARIABLES DE ENTORNO PARA DOCKER & PRODUCCIÓN (AWS LIGHTSAIL)
# ==============================================================================
# Copia este archivo como .env en la raíz del proyecto para desplegar con Docker Compose.
# ==============================================================================

# --- Base de Datos PostgreSQL ---
DB_NAME=db_specialized
DB_USER=gr_admin
DB_PASSWORD=specialized_prod_secure_pass_2026!

# --- JWT (Seguridad Token) ---
# Clave secreta robusta (Mínimo 32 caracteres)
JWT_SECRET=SDI_PROD_JWT_SECRET_KEY_8a92f8b1c4e6a0d2f7e3b1c9a8e5f7d2

# --- Entorno y Depuración ---
APP_ENV=produccion
APP_DEBUG=false

# --- Configuración SMTP (Recuperación de Contraseñas por Email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=specializedinst@yahoo.es
SMTP_PASS=tu_clave_de_aplicacion_aqui
SMTP_FROM_NAME=SPECIALIZED
